{
  "name": "clueai",
  "private": true,
  "version": "5.8.6",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "pack": "npm run build && electron-builder --dir",
    "docker:build": "docker build -t clueai:latest .",
    "docker:run": "docker run -d -p 3000:80 --name clueai-app clueai:latest",
    "docker:compose": "docker compose up -d --build"
  },
  "build": {
    "appId": "com.clueai.app",
    "productName": "ClueAI",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "artifactName": "ClueAI.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "ClueAI.${ext}",
      "identity": null
    },
    "dmg": {
      "artifactName": "ClueAI.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "uninstallDisplayName": "ClueAI",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "HelloWorld-Farhan",
        "repo": "ClueAi"
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.400.0",
    "openai": "^4.52.0",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1"
  },
  "optionalDependencies": {
    "win-audio": "^3.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "jimp": "^1.6.1",
    "oxlint": "^1.71.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "win-audio": true
  }
}
